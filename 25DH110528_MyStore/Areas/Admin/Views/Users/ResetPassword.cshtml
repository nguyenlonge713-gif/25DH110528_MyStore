@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid" style="padding: 20px;">

    <h2 style="margin-bottom: 25px;">
        <i class="glyphicon glyphicon-lock"></i>
        Đặt lại mật khẩu
    </h2>

    <div class="panel panel-default"
         style="max-width: 650px;">

        <div class="panel-heading">
            <strong>Thông tin đặt lại mật khẩu</strong>
        </div>

        <div class="panel-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <div class="alert alert-info">
                Bạn đang đặt lại mật khẩu cho tài khoản:
                <strong>@ViewBag.Username</strong>
            </div>

            @using (Html.BeginForm(
                "ResetPassword",
                "Users",
                new { area = "Admin" },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.Hidden("username", (string)ViewBag.Username)

                <div class="form-group">
                    <label>Username</label>

                    <input type="text"
                           class="form-control"
                           value="@ViewBag.Username"
                           readonly />
                </div>

                <div class="form-group">
                    <label>Mật khẩu mới</label>

                    <input type="password"
                           name="newPassword"
                           class="form-control"
                           placeholder="Nhập mật khẩu mới"
                           minlength="8"
                           maxlength="30"
                           required />
                </div>

                <div class="form-group">
                    <label>Xác nhận mật khẩu mới</label>

                    <input type="password"
                           name="confirmPassword"
                           class="form-control"
                           placeholder="Nhập lại mật khẩu mới"
                           minlength="8"
                           maxlength="30"
                           required />
                </div>

                <div class="alert alert-warning">
                    <strong>Yêu cầu mật khẩu:</strong>
                    <ul style="margin-bottom: 0; margin-top: 8px;">
                        <li>Từ 8 đến 30 ký tự.</li>
                        <li>Có ít nhất một chữ hoa.</li>
                        <li>Có ít nhất một chữ thường.</li>
                        <li>Có ít nhất một chữ số.</li>
                        <li>Có ít nhất một ký tự đặc biệt.</li>
                    </ul>
                </div>

                <button type="submit" class="btn btn-danger">
                    <i class="glyphicon glyphicon-lock"></i>
                    Xác nhận đặt lại mật khẩu
                </button>

                <a href="@Url.Action(
                    "Index",
                    "Users",
                    new { area = "Admin" })"
                   class="btn btn-default">
                    Quay lại
                </a>
            }

        </div>
    </div>
</div>