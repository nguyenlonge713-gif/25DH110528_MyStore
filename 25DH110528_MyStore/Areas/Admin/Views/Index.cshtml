
@model _25DH110528_MyStore.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link href="~/Content/PagedList.css" rel="stylesheet" />

<style>
    .product-admin-page {
        padding: 25px 15px 40px;
        color: #263445;
    }

        .product-admin-page .page-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid #e8edf3;
        }

        .product-admin-page .page-title {
            margin: 0 0 7px;
            color: #1e293b;
            font-size: 27px;
            font-weight: 700;
        }

        .product-admin-page .page-description {
            margin: 0;
            color: #718096;
            font-size: 14px;
        }

        .product-admin-page .title-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            margin-right: 10px;
            border-radius: 10px;
            background: #e8f0ff;
            color: #2563eb;
            font-size: 19px;
            vertical-align: middle;
        }

        .product-admin-page .btn-add-product {
            padding: 11px 18px;
            color: #fff;
            background: #2563eb;
            border: 1px solid #2563eb;
            border-radius: 7px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.2s;
        }

            .product-admin-page .btn-add-product:hover {
                color: #fff;
                background: #1d4ed8;
                border-color: #1d4ed8;
                text-decoration: none;
            }

        .product-admin-page .filter-card,
        .product-admin-page .list-card {
            margin-bottom: 22px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e5eaf0;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
        }

        .product-admin-page .section-header {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 22px;
            background: #f8fafc;
            border-bottom: 1px solid #e8edf3;
        }

            .product-admin-page .section-header .glyphicon {
                color: #2563eb;
                font-size: 17px;
            }

        .product-admin-page .section-title {
            margin: 0;
            color: #263445;
            font-size: 16px;
            font-weight: 700;
        }

        .product-admin-page .filter-body {
            padding: 22px;
        }

        .product-admin-page .filter-grid {
            display: grid;
            grid-template-columns: minmax(220px, 2fr) repeat(3, minmax(130px, 1fr));
            gap: 15px;
            align-items: end;
        }

        .product-admin-page .filter-group label {
            display: block;
            margin-bottom: 8px;
            color: #475569;
            font-size: 13px;
            font-weight: 600;
        }

        .product-admin-page .filter-control {
            width: 100%;
            height: 42px;
            padding: 9px 12px;
            color: #334155;
            background: #fff;
            border: 1px solid #dbe2ea;
            border-radius: 7px;
            box-shadow: none;
            outline: none;
            transition: 0.2s;
        }

            .product-admin-page .filter-control:focus {
                border-color: #60a5fa;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
            }

        .product-admin-page .filter-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .product-admin-page .btn-search {
            padding: 10px 19px;
            color: #fff;
            background: #2563eb;
            border: 1px solid #2563eb;
            border-radius: 7px;
            font-weight: 600;
        }

            .product-admin-page .btn-search:hover {
                color: #fff;
                background: #1d4ed8;
            }

        .product-admin-page .btn-reset {
            padding: 10px 17px;
            color: #475569;
            background: #fff;
            border: 1px solid #d7dee8;
            border-radius: 7px;
            font-weight: 600;
            text-decoration: none;
        }

            .product-admin-page .btn-reset:hover {
                color: #1e293b;
                background: #f1f5f9;
                text-decoration: none;
            }

        .product-admin-page .list-body {
            padding: 20px;
        }

        .product-admin-page .glyphicon {
            margin-right: 5px;
        }

    @@media (max-width: 900px) {
        .product-admin-page .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {
        .product-admin-page {
            padding: 15px 8px 25px;
        }

            .product-admin-page .page-header-custom {
                align-items: stretch;
                flex-direction: column;
            }

            .product-admin-page .btn-add-product {
                text-align: center;
            }

            .product-admin-page .filter-grid {
                grid-template-columns: 1fr;
            }

            .product-admin-page .filter-body,
            .product-admin-page .list-body {
                padding: 15px;
            }

            .product-admin-page .filter-actions {
                flex-direction: column;
            }

                .product-admin-page .filter-actions .btn {
                    width: 100%;
                }
    }
</style>

<div class="product-admin-page">

    <!-- Tiêu đề trang -->
    <div class="page-header-custom">

        <div>
            <h2 class="page-title" style="color:red !important; font-size:40px !important;">
                KIỂM TRA INDEX MỚI - 123456
                <span class="title-icon">
                    <span class="glyphicon glyphicon-th-list"></span>
                </span>
                Quản lý sản phẩm
            </h2>

            <p class="page-description">
                Quản lý thông tin, giá bán và danh sách sản phẩm trong hệ thống.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                     "Thêm sản phẩm",
                     "Create",
                     null,
                     new { @class = "btn btn-add-product" }
                 )
        </div>

    </div>

    <!-- Khu vực tìm kiếm và lọc -->
    <div class="filter-card">

        <div class="section-header">
            <span class="glyphicon glyphicon-filter"></span>
            <h4 class="section-title">Tìm kiếm và lọc sản phẩm</h4>
        </div>

        <div class="filter-body">

            @using (Html.BeginForm(
                "Index",
                "Products",
                FormMethod.Get,
                new { @class = "product-filter-form" }))
            {
                <div class="filter-grid">

                    <div class="filter-group">
                        <label for="searchTerm">Từ khóa tìm kiếm</label>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="filter-control"
                               placeholder="Tên, mô tả, danh mục..." />
                    </div>

                    <div class="filter-group">
                        <label for="minPrice">Giá từ</label>

                        <input type="number"
                               id="minPrice"
                               name="minPrice"
                               value="@Model.MinPrice"
                               min="0"
                               class="filter-control"
                               placeholder="Giá thấp nhất" />
                    </div>

                    <div class="filter-group">
                        <label for="maxPrice">Giá đến</label>

                        <input type="number"
                               id="maxPrice"
                               name="maxPrice"
                               value="@Model.MaxPrice"
                               min="0"
                               class="filter-control"
                               placeholder="Giá cao nhất" />
                    </div>

                    <div class="filter-group">
                        <label for="sortOrder">Sắp xếp theo</label>

                        <select id="sortOrder"
                                name="sortOrder"
                                class="filter-control">

                            <option value=""
                                    @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>
                                Mặc định
                            </option>

                            <option value="name_asc"
                                    @(Model.SortOrder == "name_asc" ? "selected" : "")>
                                Tên A → Z
                            </option>

                            <option value="name_desc"
                                    @(Model.SortOrder == "name_desc" ? "selected" : "")>
                                Tên Z → A
                            </option>

                            <option value="price_asc"
                                    @(Model.SortOrder == "price_asc" ? "selected" : "")>
                                Giá tăng dần
                            </option>

                            <option value="price_desc"
                                    @(Model.SortOrder == "price_desc" ? "selected" : "")>
                                Giá giảm dần
                            </option>

                        </select>
                    </div>

                </div>

                <div class="filter-actions">

                    <button type="submit" class="btn btn-search">
                        <span class="glyphicon glyphicon-search"></span>
                        Tìm kiếm
                    </button>

                    @Html.ActionLink(
                             "Đặt lại bộ lọc",
                             "Index",
                             "Products",
                             null,
                             new { @class = "btn btn-reset" }
                         )

                </div>
            }

        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="list-card">

        <div class="section-header">
            <span class="glyphicon glyphicon-list-alt"></span>
            <h4 class="section-title">Danh sách sản phẩm</h4>
        </div>

        <div class="list-body">

            @Html.Partial("PVListProduct", Model)

        </div>

    </div>

</div>
