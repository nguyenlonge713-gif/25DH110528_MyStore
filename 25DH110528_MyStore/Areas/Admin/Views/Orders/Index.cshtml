
@model IEnumerable<_25DH110528_MyStore.Models.Order>

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string customerName = ViewBag.CustomerName as string ?? "";
    string paymentStatus = ViewBag.PaymentStatus as string ?? "";
    string orderDate = ViewBag.OrderDate as string ?? "";
}

<div class="container-fluid">

    <h2 class="mb-4">
        <i class="glyphicon glyphicon-shopping-cart"></i>
        Quản lý đơn hàng
    </h2>

    @* THÔNG BÁO *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @* THỐNG KÊ *@
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số đơn hàng</h6>
                    <h3>@Model.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Chờ xác nhận</h6>
                    <h3>
                        @Model.Count(o =>
                                 (o.OrderStatus ?? "").Trim() == "Chờ xác nhận")
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Đã giao</h6>
                    <h3>
                        @Model.Count(o =>
                                 (o.OrderStatus ?? "").Trim() == "Đã giao")
                    </h3>
                </div>
            </div>
        </div>

    </div>

    @* TÌM KIẾM VÀ LỌC *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">
                <i class="glyphicon glyphicon-search"></i>
                Tìm kiếm và lọc đơn hàng
            </h5>

            @using (Html.BeginForm(
                "Index",
                "Orders",
                new { area = "Admin" },
                FormMethod.Get,
                new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-4">
                    <label for="customerName" class="form-label">
                        Tên khách hàng
                    </label>

                    <input type="text"
                           id="customerName"
                           name="customerName"
                           class="form-control"
                           placeholder="Nhập tên khách hàng..."
                           value="@customerName" />
                </div>

                <div class="col-md-3">
                    <label for="paymentStatus" class="form-label">
                        Trạng thái thanh toán
                    </label>

                    <select id="paymentStatus"
                            name="paymentStatus"
                            class="form-select">

                        <option value="">Tất cả trạng thái</option>

                        <option value="Đã thanh toán"
                                @(paymentStatus == "Đã thanh toán" ? "selected" : "")>
                            Đã thanh toán
                        </option>

                        <option value="Chưa thanh toán"
                                @(paymentStatus == "Chưa thanh toán" ? "selected" : "")>
                            Chưa thanh toán
                        </option>

                        <option value="Chưa cập nhật"
                                @(paymentStatus == "Chưa cập nhật" ? "selected" : "")>
                            Chưa cập nhật
                        </option>

                    </select>
                </div>

                <div class="col-md-3">
                    <label for="orderDate" class="form-label">
                        Ngày đặt hàng
                    </label>

                    <input type="date"
                           id="orderDate"
                           name="orderDate"
                           class="form-control"
                           value="@orderDate" />
                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary w-100 mb-2">
                        <i class="glyphicon glyphicon-search"></i>
                        Lọc đơn hàng
                    </button>

                    <a href="@Url.Action("Index", "Orders", new { area = "Admin" })"
                       class="btn btn-secondary w-100">
                        <i class="glyphicon glyphicon-refresh"></i>
                        Xóa bộ lọc
                    </a>

                </div>
            }

            @if (!string.IsNullOrWhiteSpace(customerName) ||
                 !string.IsNullOrWhiteSpace(paymentStatus) ||
                 !string.IsNullOrWhiteSpace(orderDate))
            {
                <hr />

                <div class="text-muted">
                    <i class="glyphicon glyphicon-filter"></i>
                    Đang áp dụng bộ lọc:
                    <strong>@Model.Count() kết quả</strong>
                </div>
            }

        </div>
    </div>

    @* DANH SÁCH ĐƠN HÀNG *@
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th style="min-width: 220px;">
                                Thanh toán
                            </th>
                            <th>Trạng thái đơn hàng</th>
                            <th style="min-width: 280px;">
                                Cập nhật trạng thái
                            </th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string currentStatus =
                                    (item.OrderStatus ?? "").Trim();

                                string currentPaymentStatus =
                                    string.IsNullOrWhiteSpace(item.PaymentStatus)
                                        ? "Chưa cập nhật"
                                        : item.PaymentStatus.Trim();

                                bool isCompleted =
                                    currentStatus == "Đã giao" ||
                                    currentStatus == "Đã hủy";

                                <tr>

                                    @* MÃ ĐƠN *@
                                    <td>
                                        <strong>#@item.OrderID</strong>
                                    </td>

                                    @* KHÁCH HÀNG *@
                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            @item.Customer.CustomerName
                                        }
                                        else
                                        {
                                            <span>Không xác định</span>
                                        }
                                    </td>

                                    @* NGÀY ĐẶT *@
                                    <td>
                                        @item.OrderDate.ToString("dd/MM/yyyy")
                                    </td>

                                    @* TỔNG TIỀN *@
                                    <td class="text-end">
                                        @item.TotalAmount.ToString("N0") đ
                                    </td>

                                    @* CẬP NHẬT THANH TOÁN *@
                                    <td>

                                        @if (currentPaymentStatus == "Đã thanh toán")
                                        {
                                            <span class="badge bg-success mb-2">
                                                Đã thanh toán
                                            </span>
                                        }
                                        else if (currentPaymentStatus == "Chưa thanh toán")
                                        {
                                            <span class="badge bg-warning text-dark mb-2">
                                                Chưa thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary mb-2">
                                                Chưa cập nhật
                                            </span>
                                        }

                                        @using (Html.BeginForm(
                                            "UpdatePaymentStatus",
                                            "Orders",
                                            new { area = "Admin" },
                                            FormMethod.Post,
                                            new { @class = "d-flex flex-column gap-2" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            @Html.Hidden("id", item.OrderID)

                                            @* Giữ lại điều kiện tìm kiếm *@
                                            @Html.Hidden("customerName", customerName)
                                            @Html.Hidden("filterPaymentStatus", paymentStatus)
                                            @Html.Hidden("orderDate", orderDate)

                                            <select name="paymentStatus"
                                                    class="form-select form-select-sm"
                                                    required>

                                                <option value="Chưa cập nhật"
                                                        @(currentPaymentStatus == "Chưa cập nhật" ? "selected" : "")>
                                                    Chưa cập nhật
                                                </option>

                                                <option value="Chưa thanh toán"
                                                        @(currentPaymentStatus == "Chưa thanh toán" ? "selected" : "")>
                                                    Chưa thanh toán
                                                </option>

                                                <option value="Đã thanh toán"
                                                        @(currentPaymentStatus == "Đã thanh toán" ? "selected" : "")>
                                                    Đã thanh toán
                                                </option>

                                            </select>

                                            <button type="submit"
                                                    class="btn btn-sm btn-success mt-1">

                                                <i class="glyphicon glyphicon-save"></i>
                                                Cập nhật thanh toán

                                            </button>
                                        }

                                    </td>

                                    @* TRẠNG THÁI ĐƠN HÀNG *@
                                    <td>

                                        @if (currentStatus == "Đã giao")
                                        {
                                            <span class="badge bg-success">
                                                <i class="glyphicon glyphicon-ok"></i>
                                                Đã giao
                                            </span>
                                        }
                                        else if (currentStatus == "Đã hủy")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="glyphicon glyphicon-remove"></i>
                                                Đã hủy
                                            </span>
                                        }
                                        else if (currentStatus == "Đang giao")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Đang giao
                                            </span>
                                        }
                                        else if (currentStatus == "Đã xác nhận")
                                        {
                                            <span class="badge bg-primary">
                                                Đã xác nhận
                                            </span>
                                        }
                                        else if (currentStatus == "Chờ xác nhận")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Chờ xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @(string.IsNullOrWhiteSpace(currentStatus)
                                                    ? "Chưa cập nhật"
                                                    : currentStatus)
                                            </span>
                                        }

                                    </td>

                                    @* CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG *@
                                    <td>

                                        @if (isCompleted)
                                        {
                                            <div class="text-center">

                                                <span class="text-muted">
                                                    <i class="glyphicon glyphicon-lock"></i>
                                                    Đơn hàng đã kết thúc
                                                </span>

                                                <br />

                                                <small class="text-muted">
                                                    Không thể thay đổi trạng thái
                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            using (Html.BeginForm(
                                                "UpdateStatus",
                                                "Orders",
                                                new { area = "Admin" },
                                                FormMethod.Post,
                                                new { @class = "d-flex flex-column gap-2" }))
                                            {
                                                @Html.AntiForgeryToken()

                                                @Html.Hidden("id", item.OrderID)

                                                <select name="orderStatus"
                                                        class="form-select form-select-sm"
                                                        required>

                                                    <option value="Chờ xác nhận"
                                                            @(currentStatus == "Chờ xác nhận" ? "selected" : "")>
                                                        Chờ xác nhận
                                                    </option>

                                                    <option value="Đã xác nhận"
                                                            @(currentStatus == "Đã xác nhận" ? "selected" : "")>
                                                        Đã xác nhận
                                                    </option>

                                                    <option value="Đang giao"
                                                            @(currentStatus == "Đang giao" ? "selected" : "")>
                                                        Đang giao
                                                    </option>

                                                    <option value="Đã giao">
                                                        Đã giao
                                                    </option>

                                                    <option value="Đã hủy">
                                                        Đã hủy
                                                    </option>

                                                </select>

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary">
                                                    <i class="glyphicon glyphicon-refresh"></i>
                                                    Cập nhật
                                                </button>
                                            }
                                        }

                                    </td>

                                    @* THAO TÁC *@
                                    <td>

                                        @Html.ActionLink(
                                                 "Chi tiết",
                                                 "Details",
                                                 new { id = item.OrderID },
                                                 new { @class = "btn btn-sm btn-outline-primary" })

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">

                                    <i class="glyphicon glyphicon-search"
                                       style="font-size: 25px; color: #999;"></i>

                                    <p class="mt-2 mb-0">
                                        Không tìm thấy đơn hàng phù hợp.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
