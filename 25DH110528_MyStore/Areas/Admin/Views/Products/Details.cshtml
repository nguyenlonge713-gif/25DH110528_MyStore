@model _25DH110528_MyStore.Models.Product

@{
    ViewBag.Title = Model != null ? Model.ProductName : "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light p-3 rounded">
            <li class="breadcrumb-item">@Html.ActionLink("Trang chủ", "Index", "Home")</li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-4">
            @Html.Partial("PVProductInfo", Model)

            <div class="mt-4 d-flex gap-2">
                <a href="#" class="btn btn-primary btn-lg">
                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                </a>
                @Html.ActionLink("Quay lại trang chủ", "Index", "Home", null, new { @class = "btn btn-secondary btn-lg" })
            </div>
        </div>
    </div>

    @if (ViewBag.RelatedProducts != null)
    {
    var relatedProducts = ViewBag.RelatedProducts as IEnumerable<_25DH110528_MyStore.Models.Product>
        ;
        if (relatedProducts != null && relatedProducts.Any())
        {
        <h3 class="mb-4 text-primary">Sản phẩm liên quan</h3>
        <div class="row">
            @foreach (var item in relatedProducts)
            {
            <div class="col-md-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? " ~ /Content/images/default.png" : item.ProductImage)"
                         class="card-img-top" alt="@item.ProductName" style="height: 180px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title text-truncate">@item.ProductName</h6>
                        <p class="card-text text-danger font-weight-bold">@item.ProductPrice.ToString("N0") VNĐ</p>
                        <div class="mt-auto">
                            @Html.ActionLink("Xem ngay", "Details", "Home", new { id = item.ProductID }, new { @class = "btn btn-sm btn-outline-primary btn-block" })
                        </div>
                    </div>
                </div>
            </div>
            }
        </div>
        }
        }
</div>