@model _25DH110528_MyStore.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<style>
    /* Chỉ áp dụng cho trang Create Product */
    .mp-create-page {
        background: #f4f7fb;
        min-height: 100vh;
        padding: 30px 0 50px;
        color: #1e293b;
    }

        .mp-create-page * {
            box-sizing: border-box;
        }

    .mp-create-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 25px;
    }

    .mp-create-breadcrumb {
        font-size: 12px;
        color: #94a3b8;
        margin-bottom: 9px;
    }

        .mp-create-breadcrumb span {
            color: #2563eb;
            font-weight: 600;
        }

    .mp-create-title {
        font-size: 27px;
        font-weight: 750;
        color: #172554;
        margin: 0 0 7px;
    }

    .mp-create-subtitle {
        color: #8492a6;
        font-size: 13px;
        margin: 0;
    }

    .mp-create-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 9px;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s;
    }

        .mp-create-back:hover {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #2563eb;
        }

    .mp-create-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 275px;
        gap: 22px;
        align-items: start;
    }

    .mp-create-main,
    .mp-create-sidebar {
        min-width: 0;
    }

    .mp-create-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 13px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .035);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .mp-create-card-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 19px 23px;
        border-bottom: 1px solid #edf1f6;
    }

    .mp-create-icon {
        width: 42px;
        height: 42px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 11px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 17px;
        flex-shrink: 0;
    }

    .mp-create-card-heading h3 {
        margin: 0 0 5px;
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
    }

    .mp-create-card-heading p {
        margin: 0;
        color: #94a3b8;
        font-size: 12px;
    }

    .mp-create-card-body {
        padding: 25px 23px;
    }

    .mp-create-sidebar .mp-create-card-body {
        padding: 20px;
    }

    .mp-create-tip {
        display: flex;
        gap: 11px;
        padding: 13px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        color: #475569;
        font-size: 12px;
        line-height: 1.7;
    }

        .mp-create-tip .glyphicon {
            color: #2563eb;
            margin-top: 3px;
        }

        .mp-create-tip strong {
            display: block;
            color: #1e40af;
            margin-bottom: 3px;
        }

    .mp-create-sidebar-title {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 15px;
    }

    .mp-create-step {
        display: flex;
        gap: 11px;
        align-items: flex-start;
        margin-bottom: 17px;
    }

        .mp-create-step:last-child {
            margin-bottom: 0;
        }

    .mp-create-step-number {
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 11px;
        font-weight: 700;
    }

    .mp-create-step strong {
        display: block;
        color: #334155;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .mp-create-step small {
        color: #94a3b8;
        font-size: 11px;
        line-height: 1.5;
    }

    .mp-create-footer {
        display: flex;
        justify-content: flex-end;
        gap: 11px;
        align-items: center;
        padding: 18px 23px;
        border-top: 1px solid #edf1f6;
        background: #fafbfd;
    }

    .mp-create-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 19px;
        background: #fff;
        border: 1px solid #dce3ed;
        border-radius: 8px;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s;
    }

        .mp-create-cancel:hover {
            background: #f1f5f9;
            color: #1e293b;
        }

    .mp-create-submit {
        padding: 11px 22px;
        border: none;
        border-radius: 8px;
        background: #2563eb;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .mp-create-submit:hover {
            background: #1d4ed8;
            box-shadow: 0 4px 12px rgba(37, 99, 235, .2);
        }

        .mp-create-submit .glyphicon {
            margin-right: 7px;
        }

    @@media (max-width: 991px) {
        .mp-create-layout {
            grid-template-columns: 1fr;
        }

        .mp-create-sidebar {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 15px;
        }
    }

    @@media (max-width: 600px) {
        .mp-create-page {
            padding: 20px 0 35px;
        }

        .mp-create-title {
            font-size: 22px;
        }

        .mp-create-card-heading,
        .mp-create-card-body {
            padding: 17px;
        }

        .mp-create-sidebar {
            display: block;
        }

        .mp-create-footer {
            padding: 15px;
        }

        .mp-create-cancel,
        .mp-create-submit {
            flex: 1;
            padding: 11px 8px;
        }
    }
</style>

<div class="mp-create-page">
    <div class="mp-create-header">
        <div>
            <div class="mp-create-breadcrumb">
                Quản trị <span> / </span> Sản phẩm <span> / </span> Thêm mới
            </div>

            <h2 class="mp-create-title">Thêm sản phẩm mới</h2>

            <p class="mp-create-subtitle">
                Tạo sản phẩm mới và cập nhật vào cửa hàng My Store.
            </p>
        </div>

        @Html.ActionLink(
        "‹  Quay lại danh sách",
        "Index",
        null,
        new { @class = "mp-create-back" })
    </div>

    @using (Html.BeginForm(
    "Create",
    "Products",
    FormMethod.Post,
    new { enctype = "multipart/form-data" }))
    {
    @Html.AntiForgeryToken()

    <div class="mp-create-layout">

        <div class="mp-create-main">
            <div class="mp-create-card">

                <div class="mp-create-card-heading">
                    <div class="mp-create-icon">
                        <span class="glyphicon glyphicon-edit"></span>
                    </div>

                    <div>
                        <h3>Thông tin sản phẩm</h3>
                        <p>Điền các thông tin cần thiết cho sản phẩm mới</p>
                    </div>
                </div>

                <div class="mp-create-card-body">
                    @Html.Partial("PVCreateEditProduct", Model)
                </div>

                <div class="mp-create-footer">
                    @Html.ActionLink(
                    "Hủy bỏ",
                    "Index",
                    null,
                    new { @class = "mp-create-cancel" })

                    <button type="submit" class="mp-create-submit">
                        <span class="glyphicon glyphicon-floppy-disk"></span>
                        Lưu sản phẩm
                    </button>
                </div>

            </div>
        </div>

        <aside class="mp-create-sidebar">

            <div class="mp-create-card">
                <div class="mp-create-card-body">
                    <h4 class="mp-create-sidebar-title">
                        <span class="glyphicon glyphicon-info-sign"
                              style="color:#2563eb;margin-right:7px;"></span>
                        Hướng dẫn
                    </h4>

                    <div class="mp-create-tip">
                        <span class="glyphicon glyphicon-lightbulb"></span>
                        <div>
                            <strong>Mẹo đăng sản phẩm</strong>
                            Hãy nhập thông tin chính xác, mô tả rõ ràng và chọn hình ảnh chất lượng để sản phẩm hiển thị chuyên nghiệp hơn.
                        </div>
                    </div>
                </div>
            </div>

            <div class="mp-create-card">
                <div class="mp-create-card-body">
                    <h4 class="mp-create-sidebar-title">Các bước thực hiện</h4>

                    <div class="mp-create-step">
                        <div class="mp-create-step-number">1</div>
                        <div>
                            <strong>Thông tin cơ bản</strong>
                            <small>Chọn danh mục và nhập tên sản phẩm.</small>
                        </div>
                    </div>

                    <div class="mp-create-step">
                        <div class="mp-create-step-number">2</div>
                        <div>
                            <strong>Giá bán</strong>
                            <small>Thiết lập giá cho sản phẩm.</small>
                        </div>
                    </div>

                    <div class="mp-create-step">
                        <div class="mp-create-step-number">3</div>
                        <div>
                            <strong>Hình ảnh</strong>
                            <small>Chọn hình ảnh đại diện phù hợp.</small>
                        </div>
                    </div>

                    <div class="mp-create-step">
                        <div class="mp-create-step-number">4</div>
                        <div>
                            <strong>Hoàn tất</strong>
                            <small>Kiểm tra thông tin và lưu sản phẩm.</small>
                        </div>
                    </div>
                </div>
            </div>

        </aside>

    </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
