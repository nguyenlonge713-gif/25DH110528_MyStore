
@model _25DH110528_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList
@using PagedList.Mvc
<div style="background:red; color:white; padding:20px; font-size:24px;">
    TEST GIAO DIỆN MỚI
</div>
<style>
    .product-list-wrapper {
        width: 100%;
    }

        .product-list-wrapper .table-container {
            overflow-x: auto;
            border: 1px solid #e5eaf0;
            border-radius: 10px;
            background: #fff;
        }

        .product-list-wrapper .product-table {
            width: 100%;
            min-width: 750px;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

            .product-list-wrapper .product-table thead th {
                padding: 16px 14px;
                color: #475569;
                background: #f8fafc;
                border-bottom: 1px solid #e2e8f0;
                border-top: none;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                vertical-align: middle;
                white-space: nowrap;
            }

            .product-list-wrapper .product-table tbody td {
                padding: 13px 14px;
                color: #475569;
                border-top: 1px solid #edf0f4;
                vertical-align: middle;
            }

            .product-list-wrapper .product-table tbody tr {
                transition: background 0.2s;
            }

                .product-list-wrapper .product-table tbody tr:hover {
                    background: #f8fbff;
                }

        .product-list-wrapper .product-image-box {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 75px;
            height: 75px;
            margin: auto;
            padding: 4px;
            overflow: hidden;
            background: #f8fafc;
            border: 1px solid #e5eaf0;
            border-radius: 9px;
        }

        .product-list-wrapper .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 6px;
        }

        .product-list-wrapper .product-name {
            display: block;
            color: #1e293b;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.5;
            min-width: 150px;
        }

        .product-list-wrapper .category-label {
            display: inline-block;
            padding: 6px 10px;
            color: #2563eb;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .product-list-wrapper .price-text {
            color: #059669;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .product-list-wrapper .empty-category {
            color: #94a3b8;
            font-size: 13px;
            font-style: italic;
        }

        .product-list-wrapper .action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            min-width: 190px;
        }

            .product-list-wrapper .action-buttons .btn {
                padding: 7px 10px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                transition: 0.2s;
            }

        .product-list-wrapper .btn-edit {
            color: #92400e;
            background: #fef3c7;
            border: 1px solid #fde68a;
        }

            .product-list-wrapper .btn-edit:hover {
                color: #78350f;
                background: #fde68a;
            }

        .product-list-wrapper .btn-details {
            color: #1d4ed8;
            background: #dbeafe;
            border: 1px solid #bfdbfe;
        }

            .product-list-wrapper .btn-details:hover {
                color: #1e40af;
                background: #bfdbfe;
            }

        .product-list-wrapper .btn-delete {
            color: #b91c1c;
            background: #fee2e2;
            border: 1px solid #fecaca;
        }

            .product-list-wrapper .btn-delete:hover {
                color: #991b1b;
                background: #fecaca;
            }

        .product-list-wrapper .action-buttons .glyphicon {
            margin-right: 3px;
        }

        .product-list-wrapper .pagination-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
            padding: 14px 0 0;
        }

        .product-list-wrapper .pagination-info {
            color: #64748b;
            font-size: 13px;
        }

            .product-list-wrapper .pagination-info strong {
                color: #1e293b;
            }

        .product-list-wrapper .pagination {
            margin: 0;
        }

            .product-list-wrapper .pagination > li > a,
            .product-list-wrapper .pagination > li > span {
                margin: 0 2px;
                color: #475569;
                border: 1px solid #e2e8f0;
                border-radius: 6px;
            }

            .product-list-wrapper .pagination > .active > a,
            .product-list-wrapper .pagination > .active > span {
                color: #fff;
                background: #2563eb;
                border-color: #2563eb;
            }

            .product-list-wrapper .pagination > li > a:hover {
                color: #1d4ed8;
                background: #eff6ff;
                border-color: #bfdbfe;
            }

        .product-list-wrapper .empty-row {
            padding: 35px 15px !important;
            color: #94a3b8 !important;
            text-align: center;
            font-size: 14px;
        }

    @@media (max-width: 600px) {
        .product-list-wrapper .pagination-area {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<div class="product-list-wrapper">

    <div class="table-container">

        <table class="table product-table">

            <thead>
                <tr>
                    <th style="width: 110px; text-align: center;">
                        Hình ảnh
                    </th>

                    <th>
                        Tên sản phẩm
                    </th>

                    <th>
                        Danh mục
                    </th>

                    <th style="width: 160px;">
                        Giá bán
                    </th>

                    <th style="width: 230px; text-align: center;">
                        Thao tác
                    </th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Products != null && Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        <tr>

                            <!-- Hình ảnh sản phẩm -->
                            <td style="text-align: center;">

                                <div class="product-image-box">

                                    <img src="@Url.Content(
                                        string.IsNullOrEmpty(item.ProductImage)
                                        ? "~/Content/images/default.png"
                                        : item.ProductImage
                                    )"
                                         class="product-image"
                                         alt="@item.ProductName"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default.png")';" />

                                </div>

                            </td>

                            <!-- Tên sản phẩm -->
                            <td>
                                <span class="product-name">
                                    @item.ProductName
                                </span>
                            </td>

                            <!-- Danh mục -->
                            <td>

                                @if (item.Category != null)
                                {
                                    <span class="category-label">
                                        @item.Category.CategoryName
                                    </span>
                                }
                                else
                                {
                                    <span class="empty-category">
                                        Chưa có danh mục
                                    </span>
                                }

                            </td>

                            <!-- Giá sản phẩm -->
                            <td>
                                <span class="price-text">
                                    @item.ProductPrice.ToString("N0") VNĐ
                                </span>
                            </td>

                            <!-- Các thao tác -->
                            <td>

                                <div class="action-buttons">

                                    @Html.ActionLink(
                                             "Sửa",
                                             "Edit",
                                             "Products",
                                             new
                                             {
                                                 area = "Admin",
                                                 id = item.ProductID
                                             },
                                             new
                                             {
                                                 @class = "btn btn-edit",
                                                 title = "Cập nhật sản phẩm"
                                             }
                                         )

                                    @Html.ActionLink(
                                             "Chi tiết",
                                             "Details",
                                             "Products",
                                             new
                                             {
                                                 area = "Admin",
                                                 id = item.ProductID
                                             },
                                             new
                                             {
                                                 @class = "btn btn-details",
                                                 title = "Xem chi tiết sản phẩm"
                                             }
                                         )

                                    @Html.ActionLink(
                                             "Xóa",
                                             "Delete",
                                             "Products",
                                             new
                                             {
                                                 area = "Admin",
                                                 id = item.ProductID
                                             },
                                             new
                                             {
                                                 @class = "btn btn-delete",
                                                 title = "Xóa sản phẩm"
                                             }
                                         )

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-row">
                            <span class="glyphicon glyphicon-inbox"
                                  style="font-size: 28px; display: block; margin-bottom: 10px;">
                            </span>

                            Không tìm thấy sản phẩm nào.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Phân trang -->
    <div class="pagination-area">

        <div class="pagination-info">

            Trang

            <strong>
                @(Model.Products.PageCount < Model.Products.PageNumber
                    ? 0
                    : Model.Products.PageNumber)
            </strong>

            /

            <strong>
                @Model.Products.PageCount
            </strong>

        </div>

        @Html.PagedListPager(
                 Model.Products,
                 page => Url.Action(
                     "Index",
                     "Products",
                     new
                     {
                         area = "Admin",
                         page = page,
                         searchTerm = Model.SearchTerm,
                         minPrice = Model.MinPrice,
                         maxPrice = Model.MaxPrice,
                         sortOrder = Model.SortOrder
                     }
                 )
             )

    </div>

</div>
