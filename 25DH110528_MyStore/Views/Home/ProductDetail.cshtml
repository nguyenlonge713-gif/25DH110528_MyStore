@model _25DH110528_MyStore.Models.Product

@{
    ViewBag.Title = Model.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var relatedProducts = ViewBag.RelatedProducts as List<_25DH110528_MyStore.Models.Product>;
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb bg-light p-3 rounded">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <!-- Ảnh sản phẩm -->
        <div class="col-md-5 mb-4 text-center">
            <div class="border rounded p-3 shadow-sm bg-white">
                <img src="@Url.Content(string.IsNullOrEmpty(Model.ProductImage) ? "~/Content/images/default.png" : Model.ProductImage)"
                     alt="@Model.ProductName"
                     class="img-fluid rounded"
                     style="max-height: 380px; object-fit: contain;" />
            </div>
        </div>

        <!-- Thông tin chi tiết -->
        <div class="col-md-7">
            <h2 class="font-weight-bold text-dark">@Model.ProductName</h2>
            <hr />
            <h3 class="text-danger font-weight-bold mb-3">
                @(Convert.ToDecimal(Model.ProductPrice).ToString("N0")) VNĐ
            </h3>

            <p class="text-muted"><strong>Trạng thái:</strong> <span class="badge bg-success">Còn hàng</span></p>

            <div class="mb-4">
                <h5 class="font-weight-bold">Mô tả sản phẩm:</h5>
                <p class="text-secondary" style="line-height: 1.6;">
                    @(string.IsNullOrEmpty(Model.ProductDescription) ? "Đang cập nhật thông tin chi tiết cho sản phẩm này." : Model.ProductDescription)
                </p>
            </div>

            <!-- Form Thêm vào giỏ hàng với số lượng chọn -->
            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new { @class = "form-inline" }))
            {
                <input type="hidden" name="id" value="@Model.ProductID" />
                <div class="d-flex align-items-center mb-4">
                    <label class="me-3 font-weight-bold">Số lượng:</label>
                    <input type="number" name="quantity" value="1" min="1" class="form-control text-center me-3" style="width: 80px;" />
                    <button type="submit" class="btn btn-warning text-white btn-lg font-weight-bold px-4">
                        <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ
                    </button>
                </div>
            }

            <div class="mt-3">
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách sản phẩm
                </a>
            </div>
        </div>
    </div>

    <!-- Sản phẩm liên quan -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <hr class="my-5" />
        <h4 class="mb-4 font-weight-bold text-primary">Sản phẩm cùng danh mục</h4>
        <div class="row">
            @foreach (var item in relatedProducts)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/images/default.png" : item.ProductImage)"
                             class="card-img-top p-3"
                             alt="@item.ProductName"
                             style="height: 180px; object-fit: contain;" />
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate font-weight-bold">@item.ProductName</h6>
                            <p class="card-text text-danger font-weight-bold mt-auto">
                                @(Convert.ToDecimal(item.ProductPrice).ToString("N0")) VNĐ
                            </p>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm btn-block">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>