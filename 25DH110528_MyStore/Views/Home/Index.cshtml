@model IEnumerable<_25DH110528_MyStore.Models.Product>

@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 1. BANNER LỚN CHÀO MỪNG GIỐNG MẪU FASTOR -->
<div class="position-relative text-white text-center mb-5"
     style="background-image: url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1600&q=80'); background-position: center; background-size: cover; background-repeat: no-repeat; height: 350px;">
    <div class="position-absolute w-100 h-100 d-flex flex-column justify-content-center align-items-center" style="background-color: rgba(0, 0, 0, 0.4);">
        <h1 class="fw-bold display-5 mb-2">Chào mừng đến trang web E-commerce</h1>
        <p class="lead mb-4">Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng</p>
        <a href="#product-section" class="btn btn-warning text-white fw-bold px-4 py-2 shadow" style="background-color: #f39c12; border: none; border-radius: 4px;">
            Bắt đầu mua sắm
        </a>
    </div>
</div>

<div class="container mb-5" id="product-section">
    <!-- THANH TÌM KIẾM TRUNG TÂM CĂN GIỮA ĐẸP CHUẨN FASTOR -->
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-3" style="color: #333; font-size: 28px;">Tìm kiếm sản phẩm</h2>

        <div style="max-width: 600px; margin: 0 auto;">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                if (ViewBag.SelectedCategory != null)
                {
                    <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategory" />
                }

                <div style="display: flex; align-items: center; border: 1px solid #ccc; border-radius: 4px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.08);">
                    <input type="text"
                           name="searchTerm"
                           value="@ViewBag.SearchTerm"
                           placeholder="Nhập tên, mô tả hoặc chủng loại sản phẩm..."
                           style="flex: 1; min-width: 0; max-width: none !important; border: none !important; outline: none !important; padding: 10px 15px; font-size: 14px; height: 42px; width: 100%; box-shadow: none !important;" />

                    <button type="submit"
                            style="background-color: #a93226; color: white; border: none; padding: 0 25px; height: 42px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: background 0.2s;">
                        Tìm kiếm
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="row">
        <!-- Cột bên trái: Danh mục sản phẩm -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded">
                <div class="card-header text-white fw-bold py-3" style="background-color: #007bff;">
                    <i class="fas fa-list me-2"></i> Danh mục sản phẩm
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index", "Home")" class="list-group-item list-group-item-action @(ViewBag.SelectedCategory == null ? "active" : "")">
                        Tất cả sản phẩm
                    </a>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories as IEnumerable<_25DH110528_MyStore.Models.Category>)
                        {
                            var isSelected = ViewBag.SelectedCategory != null && (int)ViewBag.SelectedCategory == cat.CategoryID;
                            <a href="@Url.Action("Index", "Home", new { categoryId = cat.CategoryID })" class="list-group-item list-group-item-action @(isSelected ? "active" : "")">
                                @cat.CategoryName
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Cột bên phải: Danh sách sản phẩm -->
        <div class="col-md-9">
            <h4 class="mb-4 fw-bold text-dark border-bottom pb-2">Danh sách sản phẩm</h4>
            <div class="row">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border rounded bg-white">
                                <div class="text-center p-3 bg-light border-bottom">
                                    <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/images/default.png" : item.ProductImage)"
                                         class="card-img-top" alt="@item.ProductName" style="height: 180px; object-fit: contain;" />
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-primary fw-bold">@item.ProductPrice.ToString("N0") VNĐ</h5>
                                    <h6 class="card-title text-truncate fw-bold text-dark mb-2" title="@item.ProductName">@item.ProductName</h6>

                                    <p class="card-text text-muted small mb-3">
                                        @(item.Category != null ? item.Category.CategoryName : "Sản phẩm")
                                        <br />
                                        <span class="text-secondary">Đã bán: 0</span>
                                    </p>

                                    <div class="mt-auto">
                                        <div class="d-grid gap-2">
                                            @Html.ActionLink("Xem chi tiết", "ProductDetail", "Home", new { id = item.ProductID }, new { @class = "btn btn-outline-primary btn-sm rounded-pill mb-1" })

                                            <a href="@Url.Action("AddToCart", "Cart", new { id = item.ProductID, quantity = 1 })" class="btn btn-warning btn-sm text-dark fw-bold rounded-pill" style="background-color: #f39c12; border: none;">
                                                <i class="fas fa-cart-plus me-1"></i> Thêm vào giỏ
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning text-center py-4" role="alert">
                            <h5>Không tìm thấy sản phẩm nào!</h5>
                            <p class="mb-0">Vui lòng thử lại với từ khóa hoặc danh mục khác.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>