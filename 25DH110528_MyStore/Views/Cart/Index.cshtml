
@model IEnumerable<_25DH110528_MyStore.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var stockByProduct =
        ViewBag.StockByProduct as System.Collections.Generic.Dictionary<int, int>
        ?? new System.Collections.Generic.Dictionary<int, int>();
}

<div class="container mt-4 mb-5">

    <h2 class="mb-4">
        <i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn
    </h2>

    @* Thông báo mua lại thành công *@
    @if (TempData["CartSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["CartSuccess"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @* Thông báo lỗi mua lại *@
    @if (TempData["ReorderError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show"
             role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ReorderError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }
    @* Thông báo lỗi cập nhật giỏ hàng *@
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["CartError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Giỏ hàng đang trống!</h4>

            <p>
                Hãy chọn thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm.
            </p>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-primary mt-2">
                <i class="fas fa-store"></i> Đến trang sản phẩm
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn giá</th>
                        <th style="width: 170px;">Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-price="@item.UnitPrice"
                            data-product-id="@item.ProductID"
                            data-stock="@(stockByProduct.ContainsKey(item.ProductID)
        ? stockByProduct[item.ProductID]
        : 0)">

                            <td class="text-center">
                                <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage)
                                    ? "~/Content/images/default.png"
                                    : item.ProductImage)"
                                     alt="@item.ProductName"
                                     style="width:70px;height:70px;object-fit:cover;"
                                     class="rounded" />
                            </td>

                            <td>
                                <strong>@item.ProductName</strong>
                            </td>

                            <td class="text-end unit-price">
                                @item.UnitPrice.ToString("N0") VNĐ
                            </td>

                            <td>
                                <div class="d-flex align-items-center justify-content-center">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-minus">
                                        -
                                    </button>

                                    <input type="number"
                                           class="form-control form-control-sm quantity-input text-center mx-1"
                                           value="@item.Quantity"
                                           min="1"
                                           max="@(stockByProduct.ContainsKey(item.ProductID)
           ? stockByProduct[item.ProductID]
           : 0)"
                                           style="width:65px;" />

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm btn-plus">
                                        +
                                    </button>
                                </div>
                            </td>

                            <td class="text-end text-danger fw-bold item-total">
                                @item.TotalPrice.ToString("N0") VNĐ
                            </td>

                            <td class="text-center">
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold fs-5">
                            Tổng tiền thanh toán:
                        </td>

                        <td class="text-end text-danger fw-bold fs-5"
                            id="cart-total">
                            @(((decimal)ViewBag.TotalAmount).ToString("N0")) VNĐ
                        </td>

                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="@Url.Action("Index", "Home")"
               class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
            </a>

            <a href="@Url.Action("Checkout", "Cart")"
               class="btn btn-success btn-lg">
                Thanh toán <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    }
</div>



@section Scripts {
    <script>
        $(document).ready(function () {

            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
            }

            // Tính tổng tiền
            function updateCartTotal() {
                var total = 0;

                $('tbody tr[data-price]').each(function () {
                    var price = parseFloat($(this).attr('data-price'));
                    var quantity = parseInt(
                        $(this).find('.quantity-input').val()
                    ) || 0;

                    total += price * quantity;
                });

                $('#cart-total').text(formatCurrency(total));
            }

            // Cập nhật số lượng và kiểm tra tồn kho
            function updateProduct(row, quantity) {

                var input = row.find('.quantity-input');

                var stock = parseInt(row.attr('data-stock')) || 0;

                var oldQuantity = parseInt(
                    input.attr('data-current-quantity')
                ) || parseInt(input.val()) || 1;

                // Không cho cập nhật nếu hết hàng
                if (stock <= 0) {
                    alert('Sản phẩm đã hết hàng.');
                    input.val(oldQuantity);
                    return;
                }

                // Kiểm tra vượt tồn kho
                if (quantity > stock) {
                    alert(
                        'Số lượng vượt quá tồn kho! Hiện chỉ còn '
                        + stock + ' sản phẩm.'
                    );

                    input.val(oldQuantity);
                    return;
                }

                // Kiểm tra số lượng không hợp lệ
                if (isNaN(quantity) || quantity < 1) {
                    quantity = 1;
                }

                // Không cần gửi nếu số lượng không thay đổi
                if (quantity === oldQuantity) {
                    input.val(oldQuantity);
                    return;
                }

                // Khóa thao tác trong lúc chờ máy chủ
                row.find('.btn-plus, .btn-minus, .quantity-input')
                    .prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("UpdateCart", "Cart")',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: row.attr('data-product-id'),
                        quantity: quantity
                    },

                    success: function (response) {

                        if (response.success) {

                            // Chỉ cập nhật giao diện sau khi máy chủ đồng ý
                            input.val(quantity);

                            input.attr(
                                'data-current-quantity',
                                quantity
                            );

                            updateCartTotal();

                        } else {

                            // Khôi phục số lượng cũ
                            input.val(oldQuantity);

                            alert(
                                response.message ||
                                'Không thể cập nhật số lượng.'
                            );

                            if (response.stock !== undefined) {
                                row.attr('data-stock', response.stock);
                                input.attr('max', response.stock);
                            }
                        }
                    },

                    error: function () {

                        input.val(oldQuantity);

                        alert(
                            'Không thể kết nối để cập nhật giỏ hàng. '
                            + 'Vui lòng thử lại.'
                        );
                    },

                    complete: function () {

                        row.find('.btn-plus, .btn-minus, .quantity-input')
                            .prop('disabled', false);
                    }
                });
            }

            // Lưu số lượng ban đầu
            $('.quantity-input').each(function () {
                $(this).attr(
                    'data-current-quantity',
                    $(this).val()
                );
            });

            // Nút tăng
            $('.btn-plus').click(function () {

                var row = $(this).closest('tr');

                var quantity = parseInt(
                    row.find('.quantity-input').val()
                ) || 1;

                updateProduct(row, quantity + 1);
            });

            // Nút giảm
            $('.btn-minus').click(function () {

                var row = $(this).closest('tr');

                var quantity = parseInt(
                    row.find('.quantity-input').val()
                ) || 1;

                if (quantity > 1) {
                    updateProduct(row, quantity - 1);
                }
            });

            // Nhập số lượng trực tiếp
            $('.quantity-input').on('change', function () {

                var row = $(this).closest('tr');

                var quantity = parseInt($(this).val());

                updateProduct(row, quantity);
            });

        });
    </script>
}

