
@model IEnumerable<_25DH110528_MyStore.Models.CartItem>

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">
    <i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn
</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <h4>Giỏ hàng đang trống!</h4>
        <p>Hãy chọn thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">
            <i class="fas fa-store"></i> Đến trang sản phẩm
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn giá</th>
                    <th style="width: 170px;">Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-price="@item.UnitPrice"
                        data-product-id="@item.ProductID">

                        <td class="text-center">
                            <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage)
                                ? "~/Content/images/default.png"
                                : item.ProductImage)"
                                 alt="@item.ProductName"
                                 style="width:70px;height:70px;object-fit:cover;"
                                 class="rounded" />
                        </td>

                        <td><strong>@item.ProductName</strong></td>

                        <td class="text-end unit-price">
                            @item.UnitPrice.ToString("N0") VNĐ
                        </td>

                        <td>
                            <div class="d-flex align-items-center justify-content-center">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm btn-minus">
                                    -
                                </button>

                                <input type="number"
                                       class="form-control form-control-sm quantity-input text-center mx-1"
                                       value="@item.Quantity"
                                       min="1"
                                       style="width:65px;" />

                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm btn-plus">
                                    +
                                </button>
                            </div>
                        </td>

                        <td class="text-end text-danger fw-bold item-total">
                            @item.TotalPrice.ToString("N0") VNĐ
                        </td>

                        <td class="text-center">
                            <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                <i class="fas fa-trash-alt"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold fs-5">
                        Tổng tiền thanh toán:
                    </td>

                    <td class="text-end text-danger fw-bold fs-5"
                        id="cart-total">
                        @(((decimal)ViewBag.TotalAmount).ToString("N0")) VNĐ
                    </td>

                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a href="@Url.Action("Index", "Home")"
           class="btn btn-outline-primary">
            <i class="fas fa-arrow-left"></i> Tiếp tục mua sắm
        </a>

        <a href="@Url.Action("Checkout", "Cart")"
           class="btn btn-success btn-lg">
            Thanh toán <i class="fas fa-arrow-right"></i>
        </a>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {

            function formatCurrency(amount) {
                return new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
            }

            function updateCartTotal() {
                var total = 0;

                $('tbody tr[data-price]').each(function () {
                    var price = parseFloat($(this).attr('data-price'));
                    var quantity = parseInt($(this).find('.quantity-input').val()) || 1;

                    total += price * quantity;
                });

                $('#cart-total').text(formatCurrency(total));
            }

            function saveQuantity(row, quantity) {
                var productId = row.attr('data-product-id');

                $.ajax({
                    url: '@Url.Action("UpdateCart", "Cart")',
                    type: 'POST',
                    data: {
                        id: productId,
                        quantity: quantity
                    },
                    success: function () {
                        console.log('Đã lưu số lượng sản phẩm.');
                    },
                    error: function () {
                        alert('Không thể cập nhật giỏ hàng. Vui lòng thử lại.');
                        location.reload();
                    }
                });
            }

            function updateProduct(row, quantity) {
                if (quantity < 1 || isNaN(quantity)) {
                    quantity = 1;
                }

                row.find('.quantity-input').val(quantity);

                var price = parseFloat(row.attr('data-price'));
                var itemTotal = price * quantity;

                row.find('.item-total').text(formatCurrency(itemTotal));

                updateCartTotal();

                saveQuantity(row, quantity);
            }

            $('.btn-plus').click(function () {
                var row = $(this).closest('tr');
                var quantity = parseInt(row.find('.quantity-input').val()) || 1;

                updateProduct(row, quantity + 1);
            });

            $('.btn-minus').click(function () {
                var row = $(this).closest('tr');
                var quantity = parseInt(row.find('.quantity-input').val()) || 1;

                if (quantity > 1) {
                    updateProduct(row, quantity - 1);
                }
            });

            $('.quantity-input').on('change', function () {
                var row = $(this).closest('tr');
                var quantity = parseInt($(this).val()) || 1;

                updateProduct(row, quantity);
            });

        });
    </script>
}