
@model IEnumerable<_25DH110528_MyStore.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string selectedStatus = ViewBag.SelectedStatus as string ?? "Chờ thanh toán";
    string keyword = ViewBag.SearchKeyword as string ?? "";

    bool hasAnyOrders = ViewBag.HasAnyOrders != null
        && (bool)ViewBag.HasAnyOrders;

    bool showAll = ViewBag.ShowAll != null
        && (bool)ViewBag.ShowAll;

    bool hasMoreOrders = ViewBag.HasMoreOrders != null
        && (bool)ViewBag.HasMoreOrders;
}

<style>
    .oh-page {
        background: #f5f6fa;
        min-height: 75vh;
        padding: 28px 0 50px;
    }

    .oh-title {
        font-size: 27px;
        font-weight: 750;
        color: #222;
        margin-bottom: 22px;
    }

    .oh-tabs {
        display: flex;
        overflow-x: auto;
        white-space: nowrap;
        background: #fff;
        border-radius: 12px;
        padding: 0 12px;
        margin-bottom: 18px;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
        scrollbar-width: thin;
    }

    .oh-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 17px 18px;
        color: #555;
        text-decoration: none;
        border-bottom: 3px solid transparent;
        font-weight: 600;
        flex-shrink: 0;
        transition: .2s;
    }

        .oh-tab:hover {
            color: #e85d04;
        }

        .oh-tab.active {
            color: #e85d04;
            border-bottom-color: #e85d04;
        }

    .oh-search {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
    }

        .oh-search .form-control {
            border-radius: 8px 0 0 8px;
            min-height: 43px;
        }

        .oh-search .btn {
            border-radius: 0 8px 8px 0;
            min-width: 105px;
        }

    .oh-order {
        background: #fff;
        border-radius: 12px;
        margin-bottom: 18px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(0,0,0,.055);
        border: 1px solid #eee;
    }

    .oh-order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px 20px;
        border-bottom: 1px solid #eee;
        background: #fff;
    }

    .oh-order-code {
        font-weight: 750;
        color: #333;
        font-size: 15px;
    }

    .oh-order-date {
        color: #888;
        font-size: 13px;
        margin-top: 4px;
    }

    .oh-status {
        font-size: 13px;
        font-weight: 700;
        padding: 8px 13px;
        border-radius: 20px;
    }

        .oh-status.waiting {
            color: #946200;
            background: #fff3cd;
        }

        .oh-status.confirmed {
            color: #0756a5;
            background: #dceeff;
        }

        .oh-status.shipping {
            color: #087990;
            background: #cff4fc;
        }

        .oh-status.delivered {
            color: #146c43;
            background: #d1e7dd;
        }

        .oh-status.cancelled {
            color: #b02a37;
            background: #f8d7da;
        }

    .oh-products {
        padding: 5px 20px;
    }

    .oh-product {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .oh-product:last-child {
            border-bottom: none;
        }

    .oh-product-img {
        width: 82px;
        height: 82px;
        object-fit: cover;
        border: 1px solid #eee;
        border-radius: 9px;
        flex-shrink: 0;
        background: #fafafa;
    }

    .oh-product-info {
        flex: 1;
        min-width: 0;
    }

    .oh-product-name {
        font-weight: 650;
        color: #333;
        margin-bottom: 7px;
        overflow-wrap: anywhere;
    }

    .oh-product-quantity {
        color: #888;
        font-size: 13px;
    }

    .oh-product-price {
        color: #e85d04;
        font-weight: 700;
        white-space: nowrap;
        text-align: right;
    }

    .oh-product-detail-link {
        display: inline-block;
        margin-top: 9px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        padding: 6px 10px;
    }

    .oh-order-footer {
        background: #fafafa;
        padding: 16px 20px;
        border-top: 1px solid #eee;
    }

    .oh-total {
        text-align: right;
        margin-bottom: 13px;
        color: #555;
    }

        .oh-total strong {
            font-size: 21px;
            color: #e85d04;
            margin-left: 8px;
        }

    .oh-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

        .oh-actions .btn {
            min-width: 125px;
            border-radius: 7px;
            font-weight: 600;
            padding: 9px 13px;
        }

    .oh-empty {
        background: #fff;
        border-radius: 12px;
        padding: 55px 20px;
        text-align: center;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
    }

        .oh-empty i {
            font-size: 48px;
            color: #c9cdd3;
            margin-bottom: 17px;
        }

        .oh-empty h5 {
            font-weight: 700;
            color: #444;
        }

        .oh-empty p {
            color: #888;
        }

    @@media (max-width: 576px) {
        .oh-page {
            padding-top: 18px;
        }

        .oh-title {
            font-size: 23px;
        }

        .oh-tab {
            padding: 14px 13px;
            font-size: 13px;
        }

        .oh-order-header {
            padding: 14px;
        }

        .oh-products {
            padding: 5px 14px;
        }

        .oh-product-img {
            width: 67px;
            height: 67px;
        }

        .oh-product {
            gap: 10px;
        }

        .oh-product-name {
            font-size: 13px;
        }

        .oh-product-price {
            font-size: 13px;
        }

        .oh-order-footer {
            padding: 14px;
        }

        .oh-total strong {
            font-size: 18px;
        }

        .oh-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

            .oh-actions .btn {
                min-width: 0;
                font-size: 13px;
            }
    }
</style>

<div class="oh-page">
    <div class="container">

        <h2 class="oh-title">
            <i class="fas fa-box-open me-2"></i>
            Đơn hàng của tôi
        </h2>

        @* THONG BAO MUA LAI *@
        @if (TempData["CartSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["CartSuccess"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ReorderError"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @TempData["ReorderError"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @* 5 TAB TRANG THAI *@
        <div class="oh-tabs">

            <a href="@Url.Action("OrderHistory", "User", new { status = "Chờ thanh toán", keyword = keyword })"
               class="oh-tab @(selectedStatus == "Chờ thanh toán" ? "active" : "")">
                Chờ thanh toán
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đang xử lý", keyword = keyword })"
               class="oh-tab @(selectedStatus == "Đang xử lý" ? "active" : "")">
                Đang xử lý
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đang vận chuyển", keyword = keyword })"
               class="oh-tab @(selectedStatus == "Đang vận chuyển" ? "active" : "")">
                Đang vận chuyển
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đã giao", keyword = keyword })"
               class="oh-tab @(selectedStatus == "Đã giao" ? "active" : "")">
                Đã giao
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đã hủy", keyword = keyword })"
               class="oh-tab @(selectedStatus == "Đã hủy" ? "active" : "")">
                Đã hủy
            </a>

        </div>

        @* THANH TIM KIEM *@
        <div class="oh-search">
            @using (Html.BeginForm(
                "OrderHistory",
                "User",
                FormMethod.Get,
                new { @class = "row g-0" }))
            {
                <input type="hidden"
                       name="status"
                       value="@selectedStatus" />

                <div class="col">
                    <input type="text"
                           name="keyword"
                           value="@keyword"
                           class="form-control"
                           placeholder="Tìm theo mã đơn hàng hoặc tên sản phẩm..." />
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-dark h-100">
                        <i class="fas fa-search me-1"></i>
                        Tìm kiếm
                    </button>
                </div>
            }
        </div>

        @* DANH SACH DON HANG *@
        @if (Model == null || !Model.Any())
        {
            <div class="oh-empty">

                @if (!hasAnyOrders)
                {
                    <i class="fas fa-shopping-bag"></i>

                    <h5>Bạn chưa có đơn hàng nào!</h5>

                    <p>Hãy chọn mua những sản phẩm yêu thích nhé.</p>

                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-primary mt-2">
                        <i class="fas fa-store me-1"></i>
                        Mua sắm ngay
                    </a>
                }
                else
                {
                    <i class="fas fa-box-open"></i>

                    <h5>Không tìm thấy đơn hàng!</h5>

                    <p>
                        Không có đơn hàng phù hợp với điều kiện tìm kiếm
                        hoặc trạng thái "@selectedStatus".
                    </p>

                    <a href="@Url.Action("OrderHistory", "User", new { status = "Chờ thanh toán" })"
                       class="btn btn-outline-primary mt-2">
                        Quay lại đơn hàng
                    </a>
                }

            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">
                    Trạng thái: <strong>@selectedStatus</strong>
                </span>

                <span class="text-muted">
                    @Model.Count() đơn hàng
                </span>
            </div>

            @* VONG LAP CAC DON HANG *@
            foreach (var order in Model)
            {
                var status = string.IsNullOrWhiteSpace(order.OrderStatus)
                    ? "Chờ xác nhận"
                    : order.OrderStatus.Trim();

                var statusClass = "waiting";
                var statusIcon = "fas fa-clock";

                if (selectedStatus == "Chờ thanh toán")
                {
                    status = "Chưa thanh toán";
                    statusClass = "waiting";
                    statusIcon = "fas fa-clock";
                }
                else if (status == "Đã xác nhận")
                {
                    statusClass = "confirmed";
                    statusIcon = "fas fa-check";
                }
                else if (status == "Đang giao")
                {
                    statusClass = "shipping";
                    statusIcon = "fas fa-truck";
                }
                else if (status == "Đã giao")
                {
                    statusClass = "delivered";
                    statusIcon = "fas fa-check-circle";
                }
                else if (status == "Đã hủy")
                {
                    statusClass = "cancelled";
                    statusIcon = "fas fa-times-circle";
                }

                <div class="oh-order">

                    @* HEADER DON HANG *@
                    <div class="oh-order-header">

                        <div>
                            <div class="oh-order-code">
                                <i class="fas fa-receipt me-1"></i>
                                Đơn hàng #@order.OrderID
                            </div>

                            <div class="oh-order-date">
                                <i class="far fa-calendar-alt me-1"></i>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <span class="oh-status @statusClass">
                            <i class="@statusIcon me-1"></i>
                            @status
                        </span>

                    </div>

                    @* DANH SACH SAN PHAM *@
                    <div class="oh-products">

                        @if (order.OrderDetails != null &&
                             order.OrderDetails.Any())
                        {
                            foreach (var detail in order.OrderDetails)
                            {
                                string productName = detail.Product != null
                                    ? detail.Product.ProductName
                                    : "Sản phẩm #" + detail.ProductID;

                                string productImage = detail.Product != null
                                    ? detail.Product.ProductImage
                                    : null;

                                <div class="oh-product">

                                    <img src="@Url.Content(
                                        string.IsNullOrWhiteSpace(productImage)
                                            ? "~/Content/images/default.png"
                                            : productImage)"
                                         alt="@productName"
                                         class="oh-product-img"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default.png")';" />

                                    <div class="oh-product-info">

                                        <div class="oh-product-name">
                                            @productName
                                        </div>

                                        <div class="oh-product-quantity">
                                            Đơn giá:
                                            @detail.UnitPrice.ToString("N0") VNĐ
                                        </div>

                                        <div class="oh-product-quantity">
                                            x @detail.Quantity
                                        </div>

                                        @* XEM CHI TIET SAN PHAM *@
                                        @if (detail.Product != null)
                                        {
                                            <a href="@Url.Action(
                                                "Details",
                                                "Home",
                                                new { id = detail.ProductID })"
                                               class="btn btn-outline-dark btn-sm oh-product-detail-link">
                                                <i class="fas fa-eye me-1"></i>
                                                Xem chi tiết 
                                            </a>
                                        }

                                    </div>

                                    <div class="oh-product-price">
                                        @((detail.UnitPrice * detail.Quantity).ToString("N0")) VNĐ
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted py-3">
                                Đơn hàng chưa có thông tin sản phẩm.
                            </div>
                        }

                    </div>

                    @* FOOTER DON HANG *@
                    <div class="oh-order-footer">

                        <div class="oh-total">
                            Tổng tiền:
                            <strong>@order.TotalAmount.ToString("N0") VNĐ</strong>
                        </div>

                        <div class="oh-actions">

                            @using (Html.BeginForm(
                                "Reorder",
                                "User",
                                new { id = order.OrderID },
                                FormMethod.Post,
                                new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Bạn muốn thêm các sản phẩm từ đơn hàng #@order.OrderID vào giỏ hàng?');">
                                    <i class="fas fa-redo me-1"></i>
                                    Mua lại
                                </button>
                            }

                        </div>

                    </div>

                </div>
            }

            @* NUT XEM THEM *@
            if (hasMoreOrders)
            {
                <div class="text-center mt-4 mb-3">
                    <a href="@Url.Action(
                        "OrderHistory",
                        "User",
                        new
                        {
                            status = selectedStatus,
                            keyword = keyword,
                            showAll = true
                        })"
                       class="btn btn-outline-dark px-4 py-2"
                       style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-chevron-down me-2"></i>
                        Xem thêm
                    </a>
                </div>
            }

            @* THONG BAO KHI DA HIEN THI TOI DA 50 DON *@
            if (showAll && Model.Count() == 50)
            {
                <div class="text-center text-muted mt-3 mb-3">
                    Đang hiển thị tối đa 50 đơn hàng gần nhất.
                </div>
            }
        }

    </div>
</div>
