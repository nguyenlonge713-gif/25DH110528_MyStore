
@model IEnumerable<_25DH110528_MyStore.Models.Order>

@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string selectedStatus = ViewBag.SelectedStatus as string ?? "Tất cả";
    bool hasAnyOrders = ViewBag.HasAnyOrders != null
        && (bool)ViewBag.HasAnyOrders;
}

<div class="container mt-4 mb-5">

    <h3 class="mb-4">
        <i class="fas fa-history me-2"></i>
        Lịch sử mua hàng
    </h3>

    @* Thong bao loi mua lai *@
    @if (TempData["ReorderError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["ReorderError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @* CAC TAB LOC DON HANG *@
    <div class="mb-4">
        <div class="d-flex flex-wrap gap-2">

            <a href="@Url.Action("OrderHistory", "User")"
               class="btn @(selectedStatus == "Tất cả" ? "btn-primary" : "btn-outline-primary")">
                <i class="fas fa-list me-1"></i>
                Tất cả
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Chờ xác nhận" })"
               class="btn @(selectedStatus == "Chờ xác nhận" ? "btn-warning" : "btn-outline-warning")">
                <i class="fas fa-clock me-1"></i>
                Chờ xác nhận
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đã xác nhận" })"
               class="btn @(selectedStatus == "Đã xác nhận" ? "btn-primary" : "btn-outline-primary")">
                <i class="fas fa-check me-1"></i>
                Đã xác nhận
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đang giao" })"
               class="btn @(selectedStatus == "Đang giao hàng" ? "btn-info" : "btn-outline-info")">
                <i class="fas fa-truck me-1"></i>
                Đang giao hàng
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đã giao" })"
               class="btn @(selectedStatus == "Đã giao hàng" ? "btn-success" : "btn-outline-success")">
                <i class="fas fa-check-circle me-1"></i>
                Đã giao hàng
            </a>

            <a href="@Url.Action("OrderHistory", "User", new { status = "Đã hủy" })"
               class="btn @(selectedStatus == "Đã hủy" ? "btn-danger" : "btn-outline-danger")">
                <i class="fas fa-times-circle me-1"></i>
                Đã hủy
            </a>

        </div>
    </div>

    @* DANH SACH DON HANG *@
    @if (Model == null || !Model.Any())
    {
        if (!hasAnyOrders)
        {
            <div class="alert alert-info text-center py-4">
                <h5>Bạn chưa có đơn hàng nào!</h5>

                <p class="mb-0">
                    Hãy chọn mua các sản phẩm yêu thích ngay nhé.
                </p>

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-primary mt-3">
                    <i class="fas fa-shopping-cart me-1"></i>
                    Mua sắm ngay
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center py-4">
                <i class="fas fa-box-open fa-2x mb-3"></i>

                <h5>Không có đơn hàng nào!</h5>

                <p class="mb-0">
                    Bạn chưa có đơn hàng với trạng thái
                    <strong>@selectedStatus</strong>.
                </p>

                <a href="@Url.Action("OrderHistory", "User")"
                   class="btn btn-primary mt-3">
                    <i class="fas fa-list me-1"></i>
                    Xem tất cả đơn hàng
                </a>
            </div>
        }
    }
    else
    {
        <div class="mb-3">
            <span class="text-muted">
                Đang hiển thị:
                <strong class="text-dark">@selectedStatus</strong>
                — @Model.Count() đơn hàng
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ giao hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái đơn hàng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var status = string.IsNullOrWhiteSpace(item.OrderStatus)
                            ? "Chờ xác nhận"
                            : item.OrderStatus.Trim();

                        var badgeClass = "bg-secondary";
                        var iconClass = "fas fa-info-circle";

                        if (status.Equals("Chờ xác nhận",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            badgeClass = "bg-warning text-dark";
                            iconClass = "fas fa-clock";
                        }
                        else if (status.Equals("Đã xác nhận",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            badgeClass = "bg-primary";
                            iconClass = "fas fa-check";
                        }
                        else if (status.Equals("Đang giao hàng",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            badgeClass = "bg-info text-dark";
                            iconClass = "fas fa-truck";
                        }
                        else if (status.Equals("Đã giao hàng",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            badgeClass = "bg-success";
                            iconClass = "fas fa-check-circle";
                        }
                        else if (status.Equals("Đã hủy",
                            StringComparison.OrdinalIgnoreCase))
                        {
                            badgeClass = "bg-danger";
                            iconClass = "fas fa-times-circle";
                        }

                        <tr>
                            <td class="text-center fw-bold">
                                #@item.OrderID
                            </td>

                            <td class="text-center">
                                @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @item.AddressDelivery
                            </td>

                            <td class="text-end text-danger fw-bold">
                                @item.TotalAmount.ToString("N0") VNĐ
                            </td>

                            <td class="text-center">
                                <span class="badge @badgeClass px-3 py-2">
                                    <i class="@iconClass me-1"></i>
                                    @status
                                </span>
                            </td>

                            <td class="text-center">
                                <div class="d-flex flex-column flex-md-row
                                            justify-content-center gap-2">

                                    @* Xem chi tiet *@
                                    <a href="@Url.Action(
                                        "OrderDetail",
                                        "User",
                                        new { id = item.OrderID })"
                                       class="btn btn-sm btn-info text-white">

                                        <i class="fas fa-eye me-1"></i>
                                        Xem chi tiết
                                    </a>

                                    @* Mua lai *@
                                    @using (Html.BeginForm(
                                        "Reorder",
                                        "User",
                                        new { id = item.OrderID },
                                        FormMethod.Post,
                                        new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-success"
                                                onclick="return confirm('Bạn muốn thêm các sản phẩm từ đơn hàng #@item.OrderID vào giỏ hàng?');">

                                            <i class="fas fa-redo me-1"></i>
                                            Mua lại
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
