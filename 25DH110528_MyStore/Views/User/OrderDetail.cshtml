@model IEnumerable<_25DH110528_MyStore.Models.OrderDetail>

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var order = ViewBag.Order as _25DH110528_MyStore.Models.Order;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fas fa-file-invoice me-2"></i> Chi tiết đơn hàng #@(order != null ? order.OrderID : 0)</h3>
        <a href="@Url.Action("OrderHistory", "User")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (order != null)
    {
        <div class="card mb-4 bg-light">
            <div class="card-body">
                <p class="mb-1"><strong>Ngày đặt hàng:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-1"><strong>Địa chỉ giao hàng:</strong> @order.AddressDelivery</p>
                <p class="mb-0"><strong>Tổng tiền thanh toán:</strong> <span class="text-danger font-weight-bold fs-5">@order.TotalAmount.ToString("N0") VNĐ</span></p>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead class="table-secondary text-center">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var detail in Model)
                    {
                        var total = detail.Quantity * detail.UnitPrice;
                        <tr>
                            <td>@(detail.Product != null ? detail.Product.ProductName : "Mã SP: " + detail.ProductID)</td>
                            <td class="text-center">@detail.Quantity</td>
                            <td class="text-end">@detail.UnitPrice.ToString("N0") VNĐ</td>
                            <td class="text-end text-danger font-weight-bold">@total.ToString("N0") VNĐ</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>