@model IEnumerable<_25DH110528_MyStore.Models.Category>

@{
    ViewBag.Title = "Danh sách danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success text-white p-2 rounded">Danh sách danh mục</h2>

@if (TempData["DeleteError"] != null)
{
    <div class="alert alert-danger">
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Không thể xóa!</strong>
        @TempData["DeleteError"]
    </div>
}

<p class="my-3">
    @Html.ActionLink(
        "Thêm mới danh mục",
        "Create",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

<table class="table table-bordered table-hover">
    <thead class="thead-dark">
        <tr>
            <th>TÊN DANH MỤC</th>
            <th style="width: 250px; text-align: center;">HÀNH ĐỘNG</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">
                        <strong>@Html.DisplayFor(modelItem => item.CategoryName)</strong>
                    </td>
                    <td class="text-center align-middle">
                        @Html.ActionLink(
                            "Cập nhật",
                            "Edit",
                            new { id = item.CategoryID },
                            new { @class = "btn btn-warning btn-sm" }
                        )

                        @Html.ActionLink(
                            "Chi tiết",
                            "Details",
                            new { id = item.CategoryID },
                            new { @class = "btn btn-info btn-sm" }
                        )

                        @Html.ActionLink(
                            "Xóa",
                            "Delete",
                            new { id = item.CategoryID },
                            new { @class = "btn btn-danger btn-sm" }
                        )
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2" class="text-center text-muted">Chưa có danh mục nào.</td>
            </tr>
        }
    </tbody>
</table>